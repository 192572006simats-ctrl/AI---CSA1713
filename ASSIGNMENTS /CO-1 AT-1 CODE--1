from collections import deque

def bfs_warehouse():
    start = (1, 1)
    goal = (5, 5)
    obstacles = {(2, 2), (2, 3), (3, 3), (4, 2), (4, 4)}
    
    # Queue stores tuples of (current_node, path_so_far)
    queue = deque([(start, [start])])
    visited = {start}
    
    step = 0
    print("--- BFS STEP-BY-STEP FRONTIER EXPANSION ---")
    while queue:
        step += 1
        current, path = queue.popleft()
        print(f"Step {step}: Expanding node {current} | Current Path: {path}")
        
        if current == goal:
            print(f"\nGoal Reached! Final Path: {path} | Total Cost: {len(path) - 1}")
            return path
            
        # Explore neighbors: Right, Down, Up, Left (or standard coordinate directions)
        x, y = current
        neighbors = [(x+1, y), (x, y+1), (x, y-1), (x-1, y)] # Right, Down, Up, Left
        
        for nx, ny in neighbors:
            if 1 <= nx <= 5 and 1 <= ny <= 5 and (nx, ny) not in obstacles and (nx, ny) not in visited:
                visited.add((nx, ny))
                queue.append(((nx, ny), path + [(nx, ny)]))

if __name__ == "__main__":
    bfs_warehouse()
