
from itertools import permutations

def tsp(graph, start):
    cities = list(range(len(graph)))
    others = [c for c in cities if c != start]

    min_cost = float('inf')
    best_route = None

    for order in permutations(others):
        route = (start,) + order + (start,)
        cost = 0

        for i in range(len(route) - 1):
            cost += graph[route[i]][route[i + 1]]

        if cost < min_cost:
            min_cost = cost
            best_route = route

    return best_route, min_cost


graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

route, cost = tsp(graph, 0)

print("Shortest Route:")
print(" -> ".join(chr(65 + city) for city in route))
print("Minimum Distance:", cost)
